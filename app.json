{
  "expo": {
    "name": "Echoes-Der Verräter",
    "slug": "qr-audio-player",
    "owner": "pascalll69",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "echoes",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.pascal.echoesderverraeter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Echoes",
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": ["de"],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsForMedia": true
        }
      }
    },
    "android": {
      "package": "de.pascal.echoesderverraeter",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Echoes nutzt die Kamera, um QR-Codes mit Audio-Links zu scannen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Echoes braucht Zugriff auf deine Fotos, um QR-Codes aus Bildern zu lesen.",
          "cameraPermission": "Echoes nutzt die Kamera, um QR-Codes mit Audio-Links zu scannen.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "0423b2e2-1e7a-410d-af81-103334e63acc"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0423b2e2-1e7a-410d-af81-103334e63acc"
    }
  }
}
